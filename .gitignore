# Build output (the vendored cool_fox tree and any out-of-tree build)
cool_fox/target/
target/
*/target/

# Local configuration (contains paths to YOUR files)
victory.toml
cool_fox/victory.toml

# Places people tend to drop data. Keep data outside the repo; nothing from
