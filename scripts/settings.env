# Settings of the measured ~100 ms/frame configuration (console profile "Series S"). Read by run.sh; every VICTORY_* variable here is passed to the runner. One line per variable, from the doc comments in cool_fox's source. Values you set in your environment before run.sh win over this file.
#
# Marks:
#   [GAIN]    one of the three settings that took the frame from ~280 to ~100 ms (they move memory, they do not skip work)
#   [REDUCED] a reduced setting: the picture is softer or simpler than the console's
#   [SKIP]    replaces the title's own result with a stand-in
#   (no mark) the settings of cool_fox's own launcher profile, unchanged

# --- The three that matter on a small card ------------------------------------
# [GAIN] Most MB of copies of title buffers kept in the card's memory (default 512 on <= 12 GB cards).
: "${VICTORY_CARD_BUFFERS_MB:=1024}"
# [GAIN] Most MB of the title's memory windows outside buffers (vertices, indices...) copied to the card (default 0: none).
: "${VICTORY_CARD_WINDOWS_MB:=256}"
# [GAIN][REDUCED] Host copies of large placed textures start this many mip levels down (0-3; patch 0002). 2 = sharper, slower.
: "${VICTORY_TEXTURE_MIP_DROP:=1}"

# --- Texture placement (our measured base) ------------------------------------
# 0: textures are not made level by level on demand; host copies hold the levels viewed (cool_fox's launcher sets 1).
: "${VICTORY_LEVELS_ON_DEMAND:=0}"
# Smallest title buffer, in KiB, whose copy goes to the card's memory (64: every buffer).
: "${VICTORY_CARD_BUFFERS_MIN_KB:=64}"

# --- User-provided overrides ------------------------------------------
# Smallest title buffer, in KiB, whose copy goes to the card's memory (64: every buffer).
: "${VICTORY_CARD_BUFFERS_MIN_KB:=64}"
# Most MB of copies of title buffers kept in the card's memory.
# 1024 is the measured GTX 1660 value; 512 is safer for 6 GB laptop cards on
# Windows to avoid "Insufficient system resources" (os error 1450).
: "${VICTORY_CARD_BUFFERS_MB:=512}"
# Textures made level by level on demand (1: on demand).
: "${VICTORY_LEVELS_ON_DEMAND:=1}"
# Raw views (0: off).
: "${VICTORY_RAW_VIEWS:=0}"
# Group sync level (2).
: "${VICTORY_GROUP_SYNC:=2}"
# Wave local mode ("idiom").
: "${VICTORY_WAVE_LOCAL:=idiom}"
# Wave wide mode (empty).
: "${VICTORY_WAVE_WIDE:=}"
# Pipeline book (1: enabled).
: "${VICTORY_PIPELINE_BOOK:=1}"
# Staging buffer idle blocks kept (each 64 MiB of PC commit memory; default 8).
# Lowered to 2 on Windows to cap idle commit and avoid os error 1450.
: "${VICTORY_STAGING_KEPT:=2}"
# Idle preludes kept (default 64; each ~5 MB commit; 0 keeps none).
# Lowered to 16 on Windows to avoid prelude-driven commit exhaustion.
: "${VICTORY_MAX_PRELUDES:=16}"

# --- cool_fox launcher profile ("pareto-residency"), unchanged -----------------
# [SKIP] Share of the fork's ambient-light estimate used in place of the title's ray-traced light (needs no rays).
: "${VICTORY_AMBIENT:=0.8}"
# [SKIP] Bounds the light the air scatters to this multiple of the light around (with the ambient stand-in).
: "${VICTORY_AMBIENT_AIR:=1.5}"
# A texture refresh that finds title memory being remapped goes on without waiting for it.
: "${VICTORY_TEXTURE_NO_WAIT:=1}"
# Relay stage 2: results of the card are landed by a thread of their own; submissions wait only for what they read.
: "${VICTORY_RELAY:=2}"
# The relay fetches its pieces over the card's copy queue, not the drawing queue.
: "${VICTORY_RELAY_COPY:=1}"
# Snapshots and compares of shader-written ranges run on several threads.
: "${VICTORY_WIDE_BACK:=1}"
# Pieces hashed again after an upload are hashed in runs that touch, each piece once.
: "${VICTORY_CARD_REHASH_RUNS:=1}"
# A title buffer copy that continues the one before it in its list becomes one step with it.
: "${VICTORY_JOIN_COPIES:=1}"
# Indirect draws reading record after record of one argument buffer are clamped a window at a time.
: "${VICTORY_INDIRECT_WINDOW:=1}"
# Indirect executions are clamped in batches; a dispatch does not end a batch.
: "${VICTORY_INDIRECT_BATCH:=2}"
# Constant-buffer fills and the title's buffer copies are done on the card, in order, not on the CPU after a wait.
: "${VICTORY_CARD_STEPS:=2}"
# Threads that map a group of pages side by side (1: the caller alone; default 8).
: "${VICTORY_MAP_THREADS:=1}"
# A small compute job keeps the card's clocks up between submissions.
: "${VICTORY_CARD_AWAKE:=1}"
# A slot shows a new texture only once the submission with its upload has finished.
: "${VICTORY_SHOW_AFTER:=1}"
# First uploads of textures picked by index go on a copy queue of their own, ahead of the frame.
: "${VICTORY_UPLOAD_AHEAD:=1}"
# List calls only write down their arguments; threads of the runner translate them.
: "${VICTORY_THIN:=1}"
# This many parts of submissions are given to the host as one.
: "${VICTORY_JOIN_PARTS:=8}"

# --- Run conveniences -----------------------------------------------------------
# Log level; "info" prints the fork's frame statistics line (fps, ms/frame) that the results come from.
: "${VICTORY_LOG:=info}"
# Scripted key presses (<seconds>:<key>,...) to get past the first screens unattended; unset it to play.
: "${VICTORY_KEYS:=30:Enter,38:Enter,46:Enter,54:Enter,62:Enter,70:Enter,78:Enter,86:Enter}"

# Optional patches (patches/optional/), off unless set here:
#   VICTORY_CARD_AWAKE=idle  keep the clocks up only while the card has nothing of ours to run (0004)
#   VICTORY_CARD_SPANS=1     diagnostics build: per-frame viewport size census (0003)
#   VICTORY_VIEW_INTEGER=0   diagnostic: typed integer buffer views left unmarked (0007)
# None of them was on in the measured runs.
